<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calculated_Duration__c</fullName>
    <description>The duration in hours between the start and end times</description>
    <externalId>false</externalId>
    <formula>If(!ISBLANK( End_Time__c), (End_Time__c - Start_Time__c) * 24, NULL)</formula>
    <inlineHelpText>The duration in hours between the start and end times</inlineHelpText>
    <label>Calculated Duration</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
